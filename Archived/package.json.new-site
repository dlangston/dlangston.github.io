{
  "name": "elliotsite",
  "private": true,
  "version": "2.0.0",
  "description": "Elliot's website rewritten with React and Tailwind",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "check:spacing": "node scripts/check-spacing-grid.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "vite build",
    "preview": "vite preview",
    "ci": "npm run check:spacing && npm run test && npm run build"
  },
  "license": "ISC",
  "dependencies": {
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.8.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.11",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^24.1.3",
    "tailwindcss": "^4.1.11",
    "vite": "^6.2.0",
    "vitest": "^4.0.18"
  }
}
